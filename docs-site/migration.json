{
  "version": 1,
  "canonical_origin": "https://docs.referential.ai",
  "redirect_origin": "https://referential.ai",
  "homepage": {
    "sources": [
      "/docs",
      "/docs/"
    ],
    "destination": "https://docs.referential.ai/"
  },
  "routes": [
    {
      "title": "Platonic",
      "redirect_sources": [
        "/docs/index.html"
      ],
      "destination": "https://docs.referential.ai/"
    },
    {
      "title": "Quickstart",
      "redirect_sources": [
        "/docs/docs/QUICKSTART.html"
      ],
      "destination": "https://docs.referential.ai/user/install/"
    },
    {
      "title": "Discord gateway",
      "redirect_sources": [
        "/docs/docs/GATEWAY.html"
      ],
      "destination": "https://docs.referential.ai/user/operations/discord/"
    },
    {
      "title": "Architecture",
      "redirect_sources": [
        "/docs/docs/ARCHITECTURE.html"
      ],
      "destination": "https://docs.referential.ai/developer/"
    }
  ]
}
